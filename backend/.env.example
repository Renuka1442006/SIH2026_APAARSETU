# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Local SQLite (Default for immediate one-command prototype running):
DATABASE_URL="file:./dev.db"

# PostgreSQL (Production / Standard deployment):
# DATABASE_URL="postgresql://postgres:password@localhost:5432/apaarsetu?schema=public"

# Authentication & Cryptographic Signing
JWT_SECRET="replace_with_a_secure_random_secret_in_production"
CREDENTIAL_SIGNING_KEY="replace_with_a_secure_server_private_key"

# Client URL (for CORS and QR code validation redirect)
CLIENT_URL="http://localhost:5173"
