{
  "name": "apaarsetu-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "APAARSetu AICTE Student Data Management and Verification Platform Backend (Node.js + Express.js)",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "clean-ports": "npx --yes kill-port 5000 5173",
    "start": "node src/server.js",
